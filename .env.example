# cp .env.example .env 후 사용
# Linux(Ubuntu)에서는 반드시 id -u 값으로 설정
AIRFLOW_UID=50000

# 호스트 포트 바인딩 주소 (기본 127.0.0.1: 이 PC에서만 접속)
# 다른 PC에서 UI/DB에 접속해야 하면 0.0.0.0 (방화벽 필수)
# BIND_IP=127.0.0.1

# 커넥션/Variable 암호화 키. 생성:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 분실 시 기존 암호화 값 복호화 불가
FERNET_KEY=

# Airflow metadata DB (postgres, host port 5431)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=airflow

# Practice DB (postgres_custom, host port 5432)
POSTGRES_CUSTOM_USER=change_me
POSTGRES_CUSTOM_PASSWORD=change_me
POSTGRES_CUSTOM_DB=change_me

# Custom image: docker build -t airflow_custom custom_image/airflow
AIRFLOW_IMAGE_NAME=airflow_custom

# Kakao API (plugins/config/get_kakao_token.py)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://example.com/oauth
KAKAO_AUTHORIZE_CODE=

# EmailOperator 수신자 (dags/dags_email_operator.py, dags/dags_python_email_xcom.py)
REDIRECT_EMAIL=

# email_on_failure 발신자 (conn_smtp_gmail 계정과 동일하게)
AIRFLOW__EMAIL__FROM_EMAIL=
