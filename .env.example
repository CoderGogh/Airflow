# cp .env.example .env 후 사용
# Linux(Ubuntu)에서는 반드시 id -u 값으로 설정
AIRFLOW_UID=50000

# Airflow metadata DB (postgres, host port 5431)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=airflow

# Practice DB (postgres_custom, host port 5432)
POSTGRES_CUSTOM_USER=change_me
POSTGRES_CUSTOM_PASSWORD=change_me
POSTGRES_CUSTOM_DB=change_me

# Custom image: docker build -t airflow_custom custom_image/airflow
AIRFLOW_IMAGE_NAME=airflow_custom

# Kakao API (plugins/config/get_kakao_token.py)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://example.com/oauth
KAKAO_AUTHORIZE_CODE=
